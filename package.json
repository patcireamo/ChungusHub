  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.server.json",
    "test": "bun test",
    "server": "bun server/index.ts",
    "server:dev": "bun --watch server/index.ts",
    "start": "vite build && bun server/index.ts",
    "package": "bun scripts/package.ts",
    "icons": "bun scripts/icons.ts"
  },
  "dependencies": {
    "dompurify": "^3.2.0",
    "gpt-tokenizer": "^3.4.0",
    "marked": "^15.0.0",
    "svelte-dnd-action": "^0.9.69"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.1.0",
    "@types/dompurify": "^3.0.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.2"
  },
  "overrides": {
    "cookie": "^1.0.2"
  }
}
