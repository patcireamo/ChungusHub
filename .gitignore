# Dependencies
node_modules/

# Build outputs
build/
dist/
.svelte-kit/
.output/

# Self-hosted server data (private: database, password, uploads)
user-data/
# Snapshots of the above, which from source land beside it inside the repo. Same
# contents, same privacy, and one snapshot is tens of thousands of files.
backups/
# Legacy name, kept ignored so any leftover copy never gets committed.
data/
# This install's own port and folders, written on its first run. It belongs to the machine
# it was created on, never to the repository.
chungushub.config.json

# TypeScript
*.tsbuildinfo

# Claude Code (personal AI assistant config)
.claude/
CLAUDE.md

# Personal notes (never committed)
notes/

# Local preset fixture, seeded like any other bundled default, never committed.
# The glob covers its cover art too: a default preset's picture is the file under
# its own name, so the pair has to be ignored as a pair.
defaults/presets/test.*

